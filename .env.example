# ========================================================
# USAMA RASHEED PORTFOLIO — ENVIRONMENT CONFIGURATION
# ========================================================

# Supabase Credentials (Connected & Reused)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-string
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-optional

# Cloudinary Configuration
# (Using Unsigned Upload Preset — No API Key or Secret needed!)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Optional signed SDK credentials (only if not using upload presets):
# CLOUDINARY_API_KEY=your-cloudinary-api-key
# CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
