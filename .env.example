# ========================================================
# USAMA RASHEED PORTFOLIO — ENVIRONMENT CONFIGURATION
# ========================================================

# Supabase Credentials (Client-side and Server-side)
# Obtain these from: Supabase Project Settings > API
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-string
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-optional

# Cloudinary Credentials (Server-side Only)
# Obtain these from: Cloudinary Console Dashboard
# Never expose CLOUDINARY_API_KEY or CLOUDINARY_API_SECRET in client code!
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Optional alternative all-in-one Cloudinary URL:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
